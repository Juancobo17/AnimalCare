# Copia este archivo como .env y coloca tus credenciales reales.
# El archivo .env NO se sube al repositorio.

# Cadena de conexion a MySQL
# Formato: mysql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="mysql://root:123456@localhost:3306/animalcare"

# Puerto donde escucha la API
PORT=4000

# Clave secreta para firmar los JWT.
# Genera la tuya con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cadena_larga_y_aleatoria_no_compartir"
JWT_EXPIRES_IN="2h"
