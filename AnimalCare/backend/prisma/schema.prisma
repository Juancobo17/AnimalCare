// Esquema de base de datos de AnimalCare
// Motor: MySQL  |  ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Estado de una mascota.
// Las mascotas NO se eliminan fisicamente: se desactivan (ACTIVE -> INACTIVE).
enum PetStatus {
  ACTIVE
  INACTIVE
}

// Tipo de cuenta. Se elige al registrarse (AN-6 cliente, AN-7 veterinario).
// ADMIN no se puede elegir en el registro: se crea con el script create-admin.
enum Role {
  CLIENT
  VETERINARIAN
  ADMIN
}

// Estado de la cuenta (AN-35, AN-37, AN-38).
// PENDING   -> veterinario recien registrado, esperando que el administrador valide su matricula
// ACTIVE    -> cuenta habilitada (los clientes nacen ACTIVE)
// SUSPENDED -> bloqueada por el administrador; no puede usar la plataforma
// REJECTED  -> registro de veterinario rechazado; no puede usar la plataforma
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  // La persona elimino su cuenta: se anonimiza y no puede volver a entrar.
  DELETED
}

// Fin de un token de un solo uso enviado por correo.
enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Modalidad de atencion de una cita.
// HOME   -> el veterinario va al domicilio del cliente (AN-10)
// CLINIC -> el cliente lleva la mascota a la veterinaria (AN-11)
enum CareMode {
  HOME
  CLINIC
}

// Ciclo de vida de una cita. Al agendarse queda PENDING.
// Las transiciones posteriores se trabajan en sprints siguientes.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  // El veterinario inicio la atencion: llena la historia clinica y luego la termina.
  IN_PROGRESS
}

model User {
  id        Int           @id @default(autoincrement())
  name      String
  email     String        @unique
  password  String
  role      Role          @default(CLIENT)
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Cuando confirmo su correo con el enlace de verificacion (null = aun no).
  emailVerifiedAt   DateTime?
  // Cuando acepto la politica de privacidad y el tratamiento de datos (Ley 1581).
  privacyAcceptedAt DateTime?
  // Cuando elimino su cuenta.
  deletedAt         DateTime?

  tokens AuthToken[]

  // Un usuario puede tener muchas mascotas (1:N)
  pets Pet[]

  // Solo los usuarios con rol VETERINARIAN tienen perfil profesional (1:1)
  vetProfile VetProfile?

  // Citas que este usuario agendo como cliente
  appointments Appointment[] @relation("ClientAppointments")

  // Avisos que el sistema le envia (aprobacion de cuenta, citas canceladas...)
  notifications Notification[]

  // Resenas que dejo como cliente despues de una cita atendida
  reviews Review[]

  // Urgencias que pidio como cliente
  emergencies EmergencyRequest[] @relation("ClientEmergencies")
}

model Pet {
  id        Int       @id @default(autoincrement())
  name      String
  species   String
  sex       String
  birthDate DateTime
  weight    Decimal?  @db.Decimal(6, 2)
  status    PetStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Toda mascota pertenece obligatoriamente a un usuario
  userId Int
  user   User @relation(fields: [userId], references: [id])

  // Citas a las que se llevo esta mascota
  appointments Appointment[]

  // Historia clinica: una entrada por consulta (AN-18 a AN-21)
  medicalRecords MedicalRecord[]

  // Urgencias en las que se uso esta mascota
  emergencies EmergencyRequest[]

  @@index([userId])
}

// Datos profesionales del veterinario (AN-7 y AN-26).
// Se crea en la misma transaccion que el usuario al registrarse.
model VetProfile {
  id             Int      @id @default(autoincrement())
  license        String   @unique // numero de matricula profesional
  specialty      String
  bio            String?  @db.Text
  // Foto de perfil (enlace a la imagen). Si no hay, el frontend muestra las iniciales.
  photoUrl       String?
  // Calificacion promedio de 0.0 a 5.0. null mientras no existan calificaciones.
  rating         Decimal? @db.Decimal(2, 1)
  phone          String?
  // Direccion del consultorio. Obligatoria si atiende en veterinaria.
  address        String?
  // Archivo de la tarjeta profesional que revisa el administrador (privado).
  licenseDocPath String?

  // Modalidades que ofrece. Controlan que puede elegir el cliente (AN-10 / AN-11).
  homeService   Boolean @default(false)
  clinicService Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  services       Service[]
  availabilities Availability[]
  appointments   Appointment[]
  blocks         ScheduleBlock[]
  reviews        Review[]
  medicalRecords MedicalRecord[]
  emergencies    EmergencyRequest[]
}

// Servicio que ofrece un veterinario (consulta, vacunacion, bano...).
// Se muestran en el perfil detallado (AN-26).
model Service {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?  @db.Text
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(30)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  appointments Appointment[]

  @@index([vetProfileId])
}

// Horario semanal de atencion del veterinario.
// De aqui salen los horarios disponibles que ve el cliente (AN-13).
model Availability {
  id        Int      @id @default(autoincrement())
  weekday   Int // 0 = domingo ... 6 = sabado
  startTime String // "09:00"
  endTime   String // "13:00"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  @@index([vetProfileId])
}

// Cita agendada por un cliente con un veterinario (AN-10, AN-11, AN-13).
model Appointment {
  id              Int               @id @default(autoincrement())
  mode            CareMode
  scheduledAt     DateTime // fecha y hora de inicio
  durationMinutes Int
  // Direccion de la visita. Obligatoria cuando la modalidad es HOME.
  address         String?
  notes           String?           @db.Text
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  clientId Int
  client   User @relation("ClientAppointments", fields: [clientId], references: [id])

  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  // El servicio es opcional: se puede agendar una consulta general.
  serviceId Int?
  service   Service? @relation(fields: [serviceId], references: [id])

  // Mascota que se atiende. Opcional para las citas anteriores a esta funcion.
  petId Int?
  pet   Pet? @relation(fields: [petId], references: [id])

  // Momento en que se envio el recordatorio de 24 horas (null = aun no).
  reminderSentAt DateTime?

  // Resena del cliente, solo despues de que la cita fue atendida.
  review Review?

  // Entrada de historia clinica registrada para esta cita (una como maximo).
  medicalRecord MedicalRecord?

  // Si la cita nacio de una urgencia aceptada por el veterinario.
  emergency EmergencyRequest?

  @@index([clientId])
  @@index([vetProfileId, scheduledAt])
}

// Bloqueo excepcional de la agenda (AN-31): un dia completo o un rango de
// horas en que el veterinario no atiende aunque su horario base lo diga.
// Los horarios que caen dentro de un bloqueo no se ofrecen al cliente.
model ScheduleBlock {
  id        Int      @id @default(autoincrement())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  @@index([vetProfileId, startsAt])
}

// Aviso dentro de la plataforma para un usuario (AN-35, AN-37, AN-31).
// Base del sistema de notificaciones (AN-22, AN-23).
model Notification {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Resena de una cita atendida. Una por cita. El promedio se guarda en
// VetProfile.rating para no recalcularlo en cada listado.
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1 a 5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  clientId Int
  client   User @relation(fields: [clientId], references: [id])

  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  @@index([vetProfileId, createdAt])
}

// Estado de una entrada de historia clinica. No se borran fisicamente:
// "eliminar" (AN-19) la anula con un motivo y se conserva para auditoria.
enum MedicalRecordStatus {
  ACTIVE
  ANNULLED
}

// Entrada de la historia clinica de una mascota (AN-18, AN-19, AN-20, AN-21).
// La historia de una mascota es la lista de sus entradas, una por consulta.
model MedicalRecord {
  id           Int                 @id @default(autoincrement())
  visitDate    DateTime // fecha de la consulta
  reason       String // motivo de consulta
  diagnosis    String              @db.Text
  treatment    String?             @db.Text
  weight       Decimal?            @db.Decimal(6, 2) // kg
  temperature  Decimal?            @db.Decimal(4, 1) // grados C
  vaccines     String?             @db.Text // vacunas aplicadas
  observations String?             @db.Text
  status       MedicalRecordStatus @default(ACTIVE)
  annulReason  String?
  annulledAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  petId Int
  pet   Pet @relation(fields: [petId], references: [id])

  // Veterinario que escribio la entrada: es el unico que puede modificarla o anularla.
  vetProfileId Int
  vetProfile   VetProfile @relation(fields: [vetProfileId], references: [id])

  // Cita de la que sale la entrada (opcional).
  appointmentId Int?         @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // Archivos adjuntos (examenes, radiografias...). Privados.
  attachments MedicalAttachment[]

  @@index([petId, visitDate])
}

// Archivo adjunto a una entrada de historia clinica (PDF, JPG o PNG).
// El archivo vive en uploads/records y solo se descarga con sesion y permiso.
model MedicalAttachment {
  id         Int      @id @default(autoincrement())
  fileName   String // nombre que ve el usuario
  storedName String   @unique // nombre en disco (aleatorio)
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  recordId Int
  record   MedicalRecord @relation(fields: [recordId], references: [id])

  @@index([recordId])
}

// Token de un solo uso para recuperar la contrasena o verificar el correo.
// Se guarda el hash (SHA-256) del token, nunca el token en claro.
model AuthToken {
  id        Int          @id @default(autoincrement())
  tokenHash String       @unique
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
}

// Estado de una urgencia.
// OPEN      -> esperando que un veterinario de turno la acepte
// ACCEPTED  -> un veterinario la tomo
// COMPLETED -> el veterinario la marco como atendida
// CANCELLED -> la cancelo el dueño
// EXPIRED   -> nadie la acepto a tiempo (EMERGENCY_TTL_MIN)
enum EmergencyStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
  EXPIRED
}

// Solicitud de atencion urgente de un dueño. Se avisa a los veterinarios de
// turno compatibles con la modalidad y el primero que la acepta se queda con ella.
model EmergencyRequest {
  id         Int             @id @default(autoincrement())
  symptoms   String          @db.Text
  mode       CareMode
  address    String? // direccion de la visita si es a domicilio
  phone      String // telefono de contacto del dueño
  status     EmergencyStatus @default(OPEN)
  createdAt  DateTime        @default(now())
  acceptedAt DateTime?
  closedAt   DateTime?

  clientId Int
  client   User @relation("ClientEmergencies", fields: [clientId], references: [id])

  petId Int?
  pet   Pet? @relation(fields: [petId], references: [id])

  // Veterinario que la acepto (null mientras esta abierta).
  vetProfileId Int?
  vetProfile   VetProfile? @relation(fields: [vetProfileId], references: [id])

  // Al aceptarla se crea una cita que ocupa la agenda del veterinario.
  appointmentId Int?         @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([status, createdAt])
  @@index([clientId])
  @@index([vetProfileId, status])
}
